# Backend Environment Variables - Chazin Food

# -------------------------------------------------------------
# Opción 1: Conexión Local (XAMPP / MySQL local)
# -------------------------------------------------------------
DB_NAME=chazinfood
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# -------------------------------------------------------------
# Opción 2: Conexión Compartida a TiDB Cloud Serverless (Nube)
# Descomenta estas líneas si quieres conectar tu backend local a TiDB Cloud:
# -------------------------------------------------------------
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=tu_usuario_tidb
# DB_PASSWORD=tu_contraseña_tidb
# DB_NAME=chazinfood
# DB_SSL=true

NODE_ENV=development
PORT=5000

# Google OAuth 2.0 (Google Cloud Console Client ID)
GOOGLE_CLIENT_ID=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Wompi Bancolombia (Sandbox)
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
